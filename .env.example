# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ai_insider"

# Google Gemini API key — used to turn a learning goal into a structured syllabus.
# Get one free at https://aistudio.google.com/app/apikey
# If unset, the app falls back to a generic 5-topic syllabus so you can still
# demo the rest of the pipeline.
GEMINI_API_KEY=""

# YouTube Data API v3 key — used to search for videos per topic.
# Get one at https://console.cloud.google.com (enable "YouTube Data API v3").
# If unset, the app falls back to mock video results so you can still demo
# the UI/progress-tracking flow without burning quota.
YOUTUBE_API_KEY=""

# NextAuth.js — required for authentication
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth — get these from Google Cloud Console
# https://console.cloud.google.com → APIs & Services → Credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""