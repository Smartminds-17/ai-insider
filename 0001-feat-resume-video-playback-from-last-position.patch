 components/TopicWaypoint.tsx     | 15 +++++++-
 components/VideoEmbed.tsx        | 64 ++++++++++++++++++++++++++++++--
 prisma/schema.prisma             | 16 ++++----
 src/application/getPath.ts       |  3 ++
 src/application/trackProgress.ts | 12 ++++++
 src/domain/types.ts              |  1 +
 8 files changed, 125 insertions(+), 17 deletions(-)

