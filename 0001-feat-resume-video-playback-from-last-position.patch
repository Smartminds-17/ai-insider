   });
 }
+
+// Saves the last playback position for a video so the player can resume from
+// where the user left off. Called periodically while playing and on
+// pause/unload — not on every timeupdate — so this stays cheap to call.
+export async function saveVideoPosition(userId: string, videoId: string, positionSec: number) {
+  const clamped = Math.max(0, Math.floor(positionSec));
+  await prisma.progress.upsert({
+    where: { userId_videoId: { userId, videoId } },
+    update: { lastPositionSec: clamped },
+    create: { userId, videoId, lastPositionSec: clamped },
+  });
+}
