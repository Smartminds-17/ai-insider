 import { NextRequest, NextResponse } from "next/server";
 import { getOrCreateUserId } from "@/infrastructure/auth/getOrCreateUserId";
-import { setVideoWatched } from "@/application/trackProgress";
+import { setVideoWatched, saveVideoPosition } from "@/application/trackProgress";
 
 export async function POST(req: NextRequest) {
   const body = await req.json().catch(() => null);
   const videoId = typeof body?.videoId === "string" ? body.videoId : null;
   const watched = typeof body?.watched === "boolean" ? body.watched : null;
+  const positionSec = typeof body?.positionSec === "number" && Number.isFinite(body.positionSec)
+    ? body.positionSec
+    : null;
 
-  if (!videoId || watched === null) {
+  if (!videoId || (watched === null && positionSec === null)) {
     return NextResponse.json(
-      { data: null, meta: {}, error: { code: "INVALID_INPUT", message: "videoId and watched are required" } },
+      { data: null, meta: {}, error: { code: "INVALID_INPUT", message: "videoId and (watched or positionSec) are required" } },
       { status: 400 }
     );
   }
 
   const userId = await getOrCreateUserId();
-  await setVideoWatched(userId, videoId, watched);
 
-  return NextResponse.json({ data: { videoId, watched }, meta: {}, error: null });
+  if (watched !== null) {
+    await setVideoWatched(userId, videoId, watched);
+  }
+  if (positionSec !== null) {
+    await saveVideoPosition(userId, videoId, positionSec);
+  }
+
+  return NextResponse.json({ data: { videoId, watched, positionSec }, meta: {}, error: null });
 }
