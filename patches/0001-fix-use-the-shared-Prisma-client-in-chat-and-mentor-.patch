Date: Mon, 19 Oct 2026 10:49:23 +0000
Subject: [PATCH 1/2] fix: use the shared Prisma client in chat and mentor
 routes

Six API routes each created their own PrismaClient at module load. On
serverless hosting every instance then opens its own connection pool, which
can exhaust the Neon connection limit under real traffic. They now import the
shared singleton from infrastructure/db/prisma, like the rest of the app.
---
 app/api/conversations/create-direct/route.ts | 4 +---
 app/api/conversations/route.ts               | 4 +---
 app/api/mentors/route.ts                     | 4 +---
 app/api/mentorships/route.ts                 | 4 +---
 app/api/messages/route.ts                    | 4 +---
 app/api/users/route.ts                       | 4 +---
 6 files changed, 6 insertions(+), 18 deletions(-)

diff --git a/app/api/conversations/create-direct/route.ts b/app/api/conversations/create-direct/route.ts
index 8d3a376..3f575ac 100644
--- a/app/api/conversations/create-direct/route.ts
+++ b/app/api/conversations/create-direct/route.ts
@@ -1,10 +1,8 @@
 import { authOptions } from '@/infrastructure/auth/auth';
-import { PrismaClient } from '@prisma/client';
+import { prisma } from '@/infrastructure/db/prisma';
 import { getServerSession } from 'next-auth/next';
 import { NextResponse } from 'next/server';
 
-const prisma = new PrismaClient();
-
 export async function POST(request: Request) {
   try {
     // Verify authenticated user
