generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Conversation {
  id                      String                    @id @default(uuid())
  type                    ConversationType
  name                    String?
  description             String?
  imageUrl                String?
  learningPathId          String?                   @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now())
  lastMessageAt           DateTime?
  lastActivityAt          DateTime                  @default(now())
  memberCount             Int                       @default(0)
  topicTags               String[]
  communityKey            String?                   @unique
  LearningPath            LearningPath?             @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]

  @@index([learningPathId])
  @@index([topicTags])
  @@index([type, createdAt])
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  Conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Goal {
  id           String         @id @default(uuid())
  userId       String
  prompt       String
  title        String
  status       GoalStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  LearningPath LearningPath[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model LearningPath {
  id           String        @id @default(uuid())
  userId       String
  prompt       String
  title        String
  status       PathStatus    @default(GENERATING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  goalId       String
  outline      Json?
  Conversation Conversation?
  Goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  User         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics       Topic[]

  @@index([createdAt, status])
  @@index([goalId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model MentorProfile {
  id                       String         @id @default(uuid())
  userId                   String         @unique
  bio                      String?
  hourlyRate               Decimal?       @db.Decimal(10, 2)
  availability             Boolean        @default(true)
  totalMenteeCount         Int            @default(0)
  averageRating            Decimal?       @db.Decimal(3, 2)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @default(now())
  maxMentees               Int            @default(5)
  stripeAccountId          String?        @unique
  stripeOnboardingComplete Boolean        @default(false)
  expertise                String[]
  User                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  MentorReview             MentorReview[]
  Mentorship               Mentorship[]

  @@index([availability])
  @@index([expertise])
  @@index([userId])
}

model MentorReview {
  id              String         @id @default(uuid())
  mentorshipId    String
  reviewerId      String
  mentorProfileId String?
  rating          Int
  comment         String?
  createdAt       DateTime       @default(now())
  MentorProfile   MentorProfile? @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  Mentorship      Mentorship     @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  User            User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([mentorshipId, reviewerId])
}

model Mentorship {
  id                    String              @id @default(uuid())
  mentorId              String
  menteeId              String
  status                MentorshipStatus    @default(PENDING)
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now())
  requestMessage        String?             @db.VarChar(1000)
  paymentStatus         PaymentStatus       @default(PENDING)
  stripePaymentIntentId String?             @unique
  MentorReview          MentorReview[]
  User                  User                @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  MentorProfile         MentorProfile       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  MentorshipSession     MentorshipSession[]

  @@unique([mentorId, menteeId])
  @@index([menteeId, status])
  @@index([mentorId, status])
}

model MentorshipSession {
  id           String        @id @default(uuid())
  mentorshipId String
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  meetingLink  String?
  notes        String?
  status       SessionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  Mentorship   Mentorship    @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@index([mentorshipId, startTime])
  @@index([startTime])
}

model Message {
  id              String            @id @default(uuid())
  conversationId  String
  senderId        String
  content         String
  messageType     MessageType       @default(TEXT)
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  parentMessageId String?
  status          MessageStatus     @default(SENT)
  Conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Message         Message?          @relation("MessageToMessage", fields: [parentMessageId], references: [id])
  other_Message   Message[]         @relation("MessageToMessage")
  User            User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  MessageReaction MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([parentMessageId])
  @@index([senderId, createdAt])
  @@index([status])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Progress {
  id                  String    @id @default(uuid())
  userId              String
  videoId             String
  watched             Boolean   @default(false)
  watchedAt           DateTime?
  watchedSeconds      Int       @default(0)
  lastPositionSec     Int       @default(0)
  updatedAt           DateTime   @default(now())
  farthestPositionSec Int       @default(0)
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Video               Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Topic {
  id              String       @id @default(uuid())
  learningPathId  String
  title           String
  order           Int
  selectedVideoId String?
  LearningPath    LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  topicVideos     TopicVideo[]

  @@unique([learningPathId, order])
  @@index([learningPathId, order])
  @@index([selectedVideoId])
}

model TopicVideo {
  id       String      @id @default(uuid())
  topicId  String
  videoId  String
  order    Int
  source   VideoSource @default(GENERATED)
  selected Boolean     @default(false)
  topic    Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  video    Video       @relation(fields: [videoId], references: [id])

  @@unique([topicId, videoId])
  @@index([topicId])
  @@index([videoId])
}

model User {
  id                        String                    @id @default(uuid())
  createdAt                 DateTime                  @default(now())
  email                     String?                   @unique
  emailVerified             DateTime?
  image                     String?
  name                      String?
  isOnline                  Boolean                   @default(false)
  lastActiveAt              DateTime?
  updatedAt                 DateTime                  @default(now())
  stripe_current_period_end DateTime?
  stripe_customer_id        String?                   @unique
  stripe_price_id           String?
  stripe_subscription_id    String?                   @unique
  Account                   Account[]
  ConversationParticipant   ConversationParticipant[]
  Goal                      Goal[]
  LearningPath              LearningPath[]
  MentorProfile             MentorProfile?
  MentorReview              MentorReview[]
  Mentorship                Mentorship[]
  Message                   Message[]
  MessageReaction           MessageReaction[]
  Progress                  Progress[]
  Session                   Session[]

  @@index([isOnline, lastActiveAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Video {
  id             String       @id @default(uuid())
  youtubeVideoId String       @unique
  title          String
  channelTitle   String
  thumbnailUrl   String
  durationSec    Int
  viewCount      BigInt
  publishedAt    DateTime
  cachedAt       DateTime     @default(now())
  progress       Progress[]
  topicVideos    TopicVideo[]
}

model YouTubeTopicCache {
  topicKey String   @id @default(uuid())
  topic    String
  videos   Json
  cachedAt DateTime @default(now())
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ParticipantRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum PathStatus {
  GENERATING
  READY
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VideoSource {
  GENERATED
  INSPIRATION
}