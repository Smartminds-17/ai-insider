new file mode 100644
index 0000000..e1123d1
--- /dev/null
+++ b/components/PathHero.tsx
@@ -0,0 +1,112 @@
+"use client";
+
+import type { PathView } from "@/domain/types";
+import VideoEmbed from "./VideoEmbed";
+
+interface ContinueVideo {
+  id: string;
+  title: string;
+  youtubeVideoId: string;
+  lastPositionSec: number;
+  topicTitle: string;
+}
+
+interface PathHeroProps {
+  path: PathView;
+  continueVideo: ContinueVideo | null;
+  progressLabel: string;
+  pct: number;
+  totalVideos: number;
+  onToggleWatched: (videoId: string, watched: boolean) => void;
+  onProgress: (videoId: string, positionSec: number) => void;
+}
+
+function formatDuration(sec: number): string {
+  const m = Math.floor(sec / 60);
+  const s = Math.floor(sec % 60);
+  return `${m}:${s.toString().padStart(2, "0")}`;
+}
+
+// "Continue watching" hero — sits above the waypoint list, spotlighting the
+// next (or in-progress) video so returning users don't have to hunt through
+// the trail for where they left off. Based on Figma frame 2019:85, adapted
+// from its fixed-px/raw-hex export onto the project's existing token set
+// (--ink, --route, .chip, .surface-card) and a responsive layout.
+export default function PathHero({
+  path,
+  continueVideo,
+  progressLabel,
+  pct,
+  totalVideos,
+  onToggleWatched,
+  onProgress,
+}: PathHeroProps) {
+  return (
+    <div className="mb-10">
+      <div className="flex flex-wrap items-center justify-center gap-2 mb-4">
+        <span className="chip chip--route">{progressLabel}</span>
+        <span className="chip chip--ink">
+          <span className="chip__dot" />
+          {path.topics.length} stops · {totalVideos} videos
+        </span>
+      </div>
+
+      <h1 className="font-display text-2xl sm:text-3xl font-medium text-center mb-6 px-4">
+        {path.title}
+      </h1>
+
+      {continueVideo ? (
+        <div className="surface-card p-3 sm:p-4 max-w-3xl mx-auto">
+          <div className="aspect-video w-full overflow-hidden rounded-[10px] bg-black">
+            <VideoEmbed
+              youtubeVideoId={continueVideo.youtubeVideoId}
+              title={continueVideo.title}
+              initialPositionSec={continueVideo.lastPositionSec}
+              onProgress={(sec) => onProgress(continueVideo.id, sec)}
+            />
+          </div>
+
+          <div className="flex items-center justify-between gap-3 mt-3 flex-wrap">
+            <div className="min-w-0">
+              <p className="legend-label legend-label--dim mb-1">
+                {continueVideo.lastPositionSec > 5
+                  ? `Resuming from ${formatDuration(continueVideo.lastPositionSec)}`
+                  : "Up next"}
+                {" · "}
+                {continueVideo.topicTitle}
+              </p>
+              <p className="text-sm text-[var(--text)] truncate">{continueVideo.title}</p>
+            </div>
+            <button
+              type="button"
+              onClick={() => onToggleWatched(continueVideo.id, true)}
+              className="chip chip--sage shrink-0"
+            >
+              Mark watched
+            </button>
+          </div>
+
+          <div className="h-1.5 rounded-full bg-[var(--ink-3)] mt-4 overflow-hidden">
+            <div
+              className="h-full rounded-full bg-[var(--route)] transition-[width] duration-300"
+              style={{ width: `${pct}%` }}
+              role="progressbar"
+              aria-valuenow={pct}
+              aria-valuemin={0}
+              aria-valuemax={100}
+              aria-label="Overall route progress"
+            />
+          </div>
+        </div>
+      ) : (
+        <div className="surface-card p-6 text-center max-w-3xl mx-auto">
+          <p className="text-sm text-[var(--text-dim)]">
+            {totalVideos === 0
+              ? "Videos are being sourced for this route."
+              : "You've watched every video on this route. Nice work."}
+          </p>
+        </div>
+      )}
+    </div>
+  );
+}
